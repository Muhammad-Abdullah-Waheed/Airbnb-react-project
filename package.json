    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "react-social-icons": "^6.18.0",
    "react-swipeable": "^7.0.1",
    "swiper": "^11.1.14"
