# Rename this file to ".env" and fill in real values locally.
# NEVER commit a real .env file.

# MongoDB Atlas connection string
# Example: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the backend listens on (hosting providers usually inject this themselves).
PORT=4000

# Node environment: development | production
NODE_ENV=development

# Comma-separated list of origins allowed by CORS in development.
# In production, set this to the URL where the frontend is deployed.
# Example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173
