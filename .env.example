# Rename this file to ".env" and fill in real values locally.
# NEVER commit a real .env file.

# Base URL of the backend API.
#   - In development: leave empty (Vite dev server proxies via axios baseURL).
#   - In production: set to the deployed backend URL, e.g. https://airbnb-api.onrender.com
VITE_API_URL=http://localhost:4000
